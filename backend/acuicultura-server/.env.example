# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcionales
# PORT=3000
# GEMINI_MODELO=gemini-3.6-flash
# Orígenes permitidos en producción, separados por comas (por defecto: localhost)
# ORIGENES_PERMITIDOS=https://midominio.com
# Número de proxies delante del servidor al publicarlo (Render, Railway, Nginx...), para que
# el límite de preguntas se aplique por usuario y no a todos juntos
# TRUST_PROXY=1
